# Server port
PORT=5000

# MongoDB Atlas connection string (M0 cluster, Mumbai recommended)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/grievanceai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/grievanceai?retryWrites=true&w=majority

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-1.5-flash, free tier limits: 15 RPM, 1M TPM, 1,500 RPD)
GEMINI_MODEL=gemini-1.5-flash

# JWT signing secret
JWT_SECRET=your_super_secret_jwt_key_here
